name: FairHire AI Offline Tests
on:
  push:
  pull_request:
jobs:
  tests:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - name: Run offline test suite
        run: python -m unittest discover -v -p 'test*.py'
      - name: Audit dataset
        run: python audit_dataset.py recruitment_data.csv
      - name: Verify dry-run plan (no API calls)
        run: python run_live.py --dry-run --limit 2 --repeats 1
